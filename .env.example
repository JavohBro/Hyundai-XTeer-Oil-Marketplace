# ─── Telegram ────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_from_botfather
BOT_USERNAME=your_bot_username_without_at
# Comma-separated admin Telegram IDs. Send /id to the bot to find one.
ADMIN_IDS=123456789,987654321

# ─── Server ──────────────────────────────────────────────────
PORT=3000
# Public HTTPS origin, no trailing slash. Telegram requires HTTPS.
WEBAPP_URL=https://your-subdomain.duckdns.org
NODE_ENV=production

# Production layout: website at "/", Mini App at "/app".
# Leave unset locally to keep the Mini App at "/".
WEB_AT_ROOT=1

# Where the database and product photos are stored. REQUIRED on hosts with
# ephemeral filesystems (Railway, Fly, Docker) — point it at a mounted volume,
# otherwise every deploy wipes your orders and images.
# Leave unset locally to use the project folder.
# DATA_DIR=/data

# ─── Local debugging only ────────────────────────────────────
# DEV_AUTH=1 lets ANY request impersonate ANY user (incl. admins) via the
# X-Dev-User-Id header. Never set this on a public server.
# DEV_AUTH=1
